# Example Keystore Properties Configuration
# Copy this file to 'keystore.properties' (or 'android/keystore.properties') and fill in your actual keystore credentials.
# DO NOT commit your actual 'keystore.properties' or keystore (.jks/.keystore) file to Git!

storeFile=release-key.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=salah-pro-release
keyPassword=YOUR_KEY_PASSWORD

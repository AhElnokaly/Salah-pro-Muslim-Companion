<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg">

    <!-- 0. Real Mosque Photographic / Illustrated Backdrop (Exact Hero Card Parity, No SVG) -->
    <ImageView
        android:id="@+id/widget_mosque_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_backdrop_hero"
        android:contentDescription="خلفية المسجد" />

    <!-- 0.1 Deep Atmospheric Scrim Overlay for Crystal-Clear Text Contrast -->
    <View
        android:id="@+id/widget_scrim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6070E20" />

    <!-- Foreground Content Layer: Pure Hero Card Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 1. Header: Hijri Date & Moon Phase (Pill Style like Hero Card) -->
        <LinearLayout
            android:id="@+id/widget_header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_date_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الثلاثاء • ١٢ ربيع الآخر ١٤٤٨ هـ"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_moon_phase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp"
                android:text="🌔 الأحدب المتزايد"
                android:textColor="#FCD34D"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Local Digital Clock (Optional, GONE by default in Pure Hero Card) -->
        <LinearLayout
            android:id="@+id/widget_clock_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="2dp">

            <TextClock
                android:id="@+id/widget_clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_clock_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="التوقيت المحلي"
                android:textColor="#FCD34D"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Next Prayer Card (Pure Hero Card: Spacious, Open, No Box-in-Box) -->
        <LinearLayout
            android:id="@+id/widget_next_prayer_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Prayer Name + Target Time Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_next_prayer_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="الصلاة القادمة: صلاة الظهر"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_next_prayer_time_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_bg"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="12:54 م"
                    android:textColor="#FCD34D"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Remaining Time + Percent -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_remaining_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏳ متبقي: باقي ٤٣ دقيقة"
                    android:textColor="#FDE68A"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(%80)"
                    android:textColor="#CBD5E1"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Sleek Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="80"
                android:progressDrawable="@drawable/widget_progress_bar_custom" />
        </LinearLayout>

        <!-- 4. 6 Prayers Horizontal Grid (Exact Hero Card Parity: Fajr, Sunrise, Dhuhr, Asr, Maghrib, Isha) -->
        <LinearLayout
            android:id="@+id/widget_prayers_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:weightSum="6">

            <!-- 1. Fajr -->
            <LinearLayout
                android:id="@+id/cell_fajr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_normal_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">

                <TextView
                    android:id="@+id/text_fajr_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الفجر"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="05:18 ص"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Sunrise (الشروق) -->
            <LinearLayout
                android:id="@+id/cell_sunrise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_normal_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">

                <TextView
                    android:id="@+id/text_sunrise_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الشروق"
                    android:textColor="#FCD34D"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_sunrise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="06:40 ص"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Dhuhr / Jumuah -->
            <LinearLayout
                android:id="@+id/cell_dhuhr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_highlight_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">

                <TextView
                    android:id="@+id/text_dhuhr_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الظهر"
                    android:textColor="#0F172A"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_time_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="12:54 م"
                    android:textColor="#0F172A"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. Asr -->
            <LinearLayout
                android:id="@+id/cell_asr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_normal_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">

                <TextView
                    android:id="@+id/text_asr_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العصر"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="04:23 م"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 5. Maghrib -->
            <LinearLayout
                android:id="@+id/cell_maghrib"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_normal_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">

                <TextView
                    android:id="@+id/text_maghrib_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المغرب"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="07:02 م"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 6. Isha -->
            <LinearLayout
                android:id="@+id/cell_isha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_normal_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">

                <TextView
                    android:id="@+id/text_isha_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العشاء"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="08:21 م"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Optional Spiritual Dhikr Quote (GONE by default in Pure Hero Card) -->
        <TextView
            android:id="@+id/widget_dhikr_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="«سُبْحَانَ اللَّهِ وَبِحَمْدِهِ ، سُبْحَانَ اللَّهِ الْعَظِيمِ»"
            android:textColor="#FEF3C7"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 6. Optional Bottom Action Bar (Tasbeeh + Khushu) (GONE by default in Pure Hero Card) -->
        <LinearLayout
            android:id="@+id/widget_bottom_actions_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Tasbeeh Counter Button -->
            <TextView
                android:id="@+id/widget_tasbeeh_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_tasbeeh_btn_bg"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="📿 تسبيح (٠)"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Khushu Toggle Button -->
            <TextView
                android:id="@+id/widget_khushu_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginLeft="5dp"
                android:background="@drawable/widget_khushu_btn_bg"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="🔔 وضع الخشوع"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
